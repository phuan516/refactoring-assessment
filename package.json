{
	"name": "chirp-monorepo",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"dev:user": "turbo run dev --filter=@chirp/client-user",
		"dev:admin": "turbo run dev --filter=@chirp/client-admin",
		"dev:api": "turbo run dev --filter=@chirp/api",
		"lint": "turbo run lint",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:unit": "turbo run test:unit",
		"test:integration": "turbo run test:integration",
		"test:e2e": "sh scripts/test-e2e.sh",
		"proto:generate": "turbo run proto:generate --filter=@chirp/proto",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:seed": "turbo run db:seed",
		"clean": "rm -rf node_modules .turbo apps/*/.turbo apps/*/.output apps/*/.vinxi apps/*/.tanstack apps/*/dist apps/*/node_modules/.vite apps/*/node_modules/.cache apps/*/playwright-report apps/*/test-results apps/*/blob-report packages/*/.turbo packages/*/dist packages/*/node_modules/.cache packages/*/generated/*.ts",
		"prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@playwright/test": "^1.57.0",
		"@faker-js/faker": "^9.3.0",
		"turbo": "^2.3.3",
		"typescript": "^5.7.2",
		"vitest": "^3.0.5"
	}
}
