{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": [
		"CI",
		"DATABASE_URL",
		"GRPC_API_HOST",
		"GRPC_JWT_SECRET",
		"GRPC_PORT",
		"HTTP_PORT",
		"SESSION_SECRET"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".output/**", ".vinxi/**", ".tanstack/**", "generated/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"test:unit": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"test:integration": {
			"dependsOn": ["^build"]
		},
		"test:e2e": {
			"dependsOn": ["build"]
		},
		"proto:generate": {
			"outputs": ["generated/**"]
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:seed": {
			"dependsOn": ["db:migrate"],
			"cache": false
		}
	}
}
